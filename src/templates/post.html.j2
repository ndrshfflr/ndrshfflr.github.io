{% extends "world.html.j2" %}
{#- One Labdiary post (post.html?slug=… / post.da.html?slug=…): the markdown in
    content/posts/<slug>.md, read in the browser. Photos linked to the post in
    the gallery follow the text. -#}
{% block styles %}<link rel="stylesheet" href="assets/pages.css?v={{ v.pagescss }}">{% endblock %}
{% block content %}
  <div class="hero chrome pg-hero">
    <span class="pg-rune" aria-hidden="true">{{ rune }}</span>
    <p class="pg-eyebrow" id="pg-meta"><time id="pg-date"></time><span class="pg-lang" id="pg-lang" hidden></span></p>
    <h1 class="nm pg-title"><span class="rv" data-k="post-title"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.loading }}</span></span></h1>
    <p class="title" id="pg-summary" hidden></p>
    <button class="aa" id="aa" type="button" aria-pressed="false" aria-label="{{ ui.aa }}">Aa</button>
  </div>

  <main class="pg-wrap" id="main" data-page="post">
    <article class="pg-paper" id="pg-article">
      <figure class="pg-hero-img" id="pg-cover" hidden><img alt=""></figure>
      <div class="pg-body" id="pg-body"><p class="pg-loading">{{ ui.loading }}</p></div>
      <p class="pg-card-tags pg-post-tags" id="pg-tags"></p>
    </article>
    <p class="pg-under"><a class="pg-link" href="{{ labdiary_href }}">&larr; {{ ui.toLabdiary }}</a></p>
  </main>

  <footer class="world-foot chrome">
    <a class="back-link" href="{{ entry_href }}"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg><span class="rv" data-k="back"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.back }}</span></span></a>
  </footer>
{% endblock %}
{% block scripts %}
<script id="pg-data" type="application/json">{{ {"fieldlog": "fieldlog.da.html" if lang == "da" else "fieldlog.html"} | tojson }}</script>
<script src="assets/markdown.js?v={{ v.md }}"></script>
<script src="assets/pages.js?v={{ v.pagesjs }}"></script>
{% endblock %}
