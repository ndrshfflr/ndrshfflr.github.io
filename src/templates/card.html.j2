<!DOCTYPE html>
<!-- GENERATED FILE — built by src/build.py (render_card) from src/templates/card.html.j2.
     The digital business card the QR code (assets/card/qr.svg) points to. -->
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ name }}</title>
<meta name="description" content="{{ ui.description }}">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0b1322">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Card">
<meta property="og:title" content="{{ name }}">
<meta property="og:description" content="{{ title }} · {{ ui.lead }}">
<meta property="og:image" content="{{ site_url }}og-image.png">
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="preload" href="assets/fonts/cinzel.woff2" as="font" type="font/woff2" crossorigin>
{% if lang == 'en' %}<script>
/* Danish phones get the Danish card, unless they chose English (?en). */
try { if (!/[?&]en\b/.test(location.search) && /^da\b/i.test(navigator.language || '')) location.replace('{{ other_href }}' + location.hash); } catch (e) {}
</script>{% endif %}
<style>
@font-face{font-family:Cinzel;src:url(assets/fonts/cinzel.woff2) format("woff2");font-weight:400 900;font-display:swap}
@font-face{font-family:"EB Garamond";src:url(assets/fonts/ebgaramond.woff2) format("woff2");font-weight:400 800;font-display:swap}
:root{--night:#0b1322;--night2:#121c30;--line:#24324d;--ink:#e8eef5;--dim:#a8b3c4;--ember:#e39a5c;--parch:#f6f1e7}
*{box-sizing:border-box}
html,body{margin:0}
body{min-height:100vh;min-height:100dvh;background:radial-gradient(120% 70% at 50% 0%,#1a2742 0%,var(--night) 60%) fixed,var(--night);
  color:var(--ink);font:18px/1.5 "EB Garamond",Georgia,serif;-webkit-font-smoothing:antialiased;
  display:flex;flex-direction:column;align-items:center;padding:max(28px,env(safe-area-inset-top)) 16px max(24px,env(safe-area-inset-bottom))}
a{color:inherit}
.card{width:100%;max-width:420px;display:flex;flex-direction:column;align-items:center;text-align:center}
.lang{align-self:flex-end;font:600 12px/1 Cinzel,serif;letter-spacing:.12em;color:var(--dim);text-decoration:none;padding:8px 4px}
/* the seeing eye, as in the worlds' header (assets/world.css): it follows the pointer (or, on a phone,
   looks where you touch), blinks now and then, and widens, glows and flickers while a link is hovered or pressed */
.eye{width:84px;height:84px;margin:6px 0 14px;color:var(--ink);overflow:visible;filter:drop-shadow(0 0 18px #e39a5c55);transition:filter .5s ease}
.eye-pupil{fill:var(--ember);transform-box:fill-box;transform-origin:center;transition:transform .45s ease}
.eye-look{transition:transform .14s ease-out}
.eye-lid{transform-box:view-box;transform-origin:50px 50px}
.card:has(a:hover,a:active,a:focus-visible) .eye-pupil,.card.awake .eye-pupil{transform:scale(1.32)}
.card:has(a:hover,a:active,a:focus-visible) .eye,.card.awake .eye{filter:drop-shadow(0 0 3px rgba(255,255,255,.85)) drop-shadow(0 0 14px #e39a5cb3)}
@keyframes eyeflicker{0%{opacity:1}7%{opacity:.62}9%{opacity:1}20%{opacity:.85}22%{opacity:1}43%{opacity:.7}45%{opacity:.98}65%{opacity:.6}67%{opacity:1}86%{opacity:.82}100%{opacity:1}}
@keyframes blink{0%,44%,48%,90%,92.5%,95%,97.5%,100%{transform:scaleY(1)}46%,91.2%,96.2%{transform:scaleY(.06)}}
@media (prefers-reduced-motion:no-preference){
  .eye-lid{animation:blink 11s ease-in-out infinite}
  .card:has(a:hover,a:active,a:focus-visible) .eye,.card.awake .eye{animation:eyeflicker 2.6s steps(1,end) infinite}
}
h1{font:600 clamp(24px,7vw,30px)/1.15 Cinzel,serif;letter-spacing:.04em;margin:0 0 8px}
.title{margin:0;color:var(--ember);font:500 14px/1.4 Cinzel,serif;letter-spacing:.14em;text-transform:uppercase}
.lead{margin:10px 0 26px;color:var(--dim);font-style:italic}
.actions{width:100%;display:grid;gap:10px}
.btn{display:flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:12px 18px;border-radius:14px;
  border:1px solid var(--line);background:#ffffff08;text-decoration:none;font:600 15px/1.2 Cinzel,serif;letter-spacing:.06em;color:var(--ink);cursor:pointer}
.btn:active{transform:scale(.99)}
.btn.primary{background:var(--ember);border-color:var(--ember);color:var(--night)}
.btn svg{width:18px;height:18px;flex:none}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.grid .btn{padding:12px 10px;letter-spacing:.03em;gap:8px;overflow-wrap:anywhere}
.rune{color:var(--ember);font:400 17px/1 serif}
.grid .btn:last-child:nth-child(odd){grid-column:1/-1}
.mail{font:16px/1.4 "EB Garamond",serif;letter-spacing:0;text-transform:none}
footer{margin-top:auto;padding-top:28px;color:#6f7d95;font-size:14px}
footer a{color:var(--dim)}
/* show-QR screen: the night code (light squares on navy), as large as the screen allows */
.qr{position:fixed;inset:0;background:var(--night);color:var(--ink);display:none;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:24px;z-index:9}
.qr:target,.qr.open{display:flex}
.qr .code{width:min(86vw,62vh,520px)}
.qr .code svg{display:block;width:100%;height:auto}
.qr p{margin:0;font:600 15px/1.3 Cinzel,serif;letter-spacing:.08em}
.qr small{font:16px "EB Garamond",serif;color:var(--dim)}
/* the owner's switch: only shown on a device signed in to /admin with the right to change the site */
.owner{width:100%;margin-top:22px;padding:14px 16px;border:1px dashed var(--line);border-radius:14px;text-align:left;font-size:16px}
.owner[hidden]{display:none}
.owner b{display:block;font:600 11px/1.2 Cinzel,serif;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:10px}
.owner input[type=tel]{width:100%;font:17px "EB Garamond",serif;padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:#ffffff0d;color:var(--ink)}
.owner .picks{display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;margin:10px 0 12px}
.owner label{display:flex;align-items:center;gap:10px;min-height:40px}
.owner button.ghost{margin-top:8px;background:transparent;border:1px solid var(--line);color:var(--ink)}
[hidden]{display:none!important}
.owner input[type=checkbox]{width:20px;height:20px;accent-color:var(--ember)}
.owner button{min-height:44px;width:100%;border:0;border-radius:12px;background:var(--ember);color:var(--night);font:600 14px Cinzel,serif;letter-spacing:.06em;cursor:pointer}
.owner button:disabled{opacity:.6}
.owner output{display:block;margin-top:8px;color:var(--dim);font-size:15px}
.qr a.close{position:absolute;top:max(16px,env(safe-area-inset-top));right:16px;font:600 13px Cinzel,serif;letter-spacing:.1em;text-decoration:none;padding:10px}
</style>
</head>
<body>
<main class="card">
  <a class="lang" href="{{ other_href }}{% if lang == 'da' %}?en{% endif %}" hreflang="{{ 'da' if lang == 'en' else 'en' }}">{{ 'DA' if lang == 'en' else 'EN' }}</a>
  <svg class="eye" viewBox="0 0 100 100" aria-hidden="true"><defs><clipPath id="eye-clip"><path d="M6 50Q50 6 94 50Q50 94 6 50Z"/></clipPath></defs><g class="eye-lid"><g clip-path="url(#eye-clip)"><g class="eye-look" id="eye-look"><circle cx="50" cy="50" r="18" fill="none" stroke="currentColor" stroke-width="2" opacity=".55"/><circle cx="50" cy="50" r="10" class="eye-pupil"/><circle cx="46.5" cy="46.5" r="2.6" fill="#fff5e8" opacity=".85"/></g></g><path d="M6 50Q50 6 94 50Q50 94 6 50Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round"/></g></svg>
  <h1>{{ name }}</h1>
  <p class="title">{{ title }}</p>
  <p class="lead">{{ ui.lead }}</p>

  <div class="actions">
    <a class="btn primary" id="save" href="card.vcf" download="{{ name | replace(' ', '-') }}.vcf">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6M19 3v6M16 6h6"/></svg>{{ ui.save }}</a>
    {% if email %}<a class="btn mail" data-share="e" href="mailto:{{ email }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>{{ email }}</a>{% endif %}
    <div class="grid" id="phone-row"{% if not phone %} hidden{% endif %}>
      <a class="btn" id="tel" data-share="p" href="tel:{{ phone | replace(' ', '') }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg><span>{{ phone }}</span></a>
      <a class="btn" id="wa" data-share="w" href="{{ whatsapp }}" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8a5 5 0 0 1-2.8-2.8l.8-1-1-2z"/></svg>{{ ui.whatsapp }}</a>
    </div>
    <div class="grid">
      {% for pg in pages %}<a class="btn" href="{{ pg.href }}">{% if pg.rune %}<span class="rune" aria-hidden="true">{{ pg.rune }}</span>{% endif %}{{ pg.name }}</a>
      {% endfor %}
      {% for s in socials %}<a class="btn" data-share="l" href="{{ s.url }}" rel="noopener">{{ s.label }}</a>{% endfor %}
    </div>
    <a class="btn" href="#qr">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 14h3v3M21 14v7h-4M14 21v-3"/></svg>{{ ui.showQr }}</a>
  </div>

  <form class="owner" id="owner" hidden>
    <b>{{ ui.owner }}</b>
    <input type="tel" id="owner-phone" placeholder="+45 12 34 56 78" aria-label="{{ ui.phone }}" title="{{ ui.phone }}" autocomplete="tel">
    <div class="picks">{% for k in ['p', 'w', 'e', 'l'] %}
      <label><input type="checkbox" value="{{ k }}">{{ ui.pick[k] }}</label>{% endfor %}
    </div>
    <button type="submit">{{ ui.showShare }}</button>
    <button type="button" class="ghost" id="owner-send">{{ ui.sendLink }}</button>
    <output id="owner-status" role="status"></output>
  </form>

  <footer><a href="{{ entry_href }}">{{ ui.site }}</a> · {{ site_host }}</footer>
</main>

<section class="qr" id="qr" aria-label="QR">
  <a class="close" href="#">{{ ui.close }} ✕</a>
  <div class="code">{{ qr_svg | safe }}</div>
  <p>{{ name }}</p>
  <small id="qr-hint">{{ ui.qrHint }} · {{ site_host }}/card</small>
</section>
<script>
/* The eye follows the pointer; on touch screens it looks toward the finger, wakes up (widens, glows,
   flickers) and drifts back. */
(function () {
  var look = document.getElementById('eye-look'), eye = document.querySelector('.card .eye');
  if (!look || !eye) return;
  var frame = 0, px = 0, py = 0, back = 0;
  function aim() {
    frame = 0;
    var r = eye.getBoundingClientRect();
    var dx = px - (r.left + r.width / 2), dy = py - (r.top + r.height / 2);
    var d = Math.sqrt(dx * dx + dy * dy) || 1, m = Math.min(1, d / 260);
    look.setAttribute('transform', 'translate(' + (dx / d * m * 8).toFixed(2) + ' ' + (dy / d * m * 4.5).toFixed(2) + ')');
  }
  var card = document.querySelector('.card'), sleep = 0;
  function follow(e) {
    px = e.clientX; py = e.clientY;
    if (e.pointerType === 'touch') { clearTimeout(back); back = setTimeout(rest, 2600); }
    /* phones have no hover: a touch wakes the eye (wider pupil, glow, flicker) for one flicker cycle */
    if (e.type === 'pointerdown' && e.pointerType !== 'mouse' && card) {
      card.classList.add('awake'); clearTimeout(sleep); sleep = setTimeout(function () { card.classList.remove('awake'); }, 2600);
    }
    if (!frame) frame = requestAnimationFrame(aim);
  }
  function rest() { look.removeAttribute('transform'); }
  document.addEventListener('pointermove', follow, { passive: true });
  document.addEventListener('pointerdown', follow, { passive: true });
  document.documentElement.addEventListener('mouseleave', rest);
})();
/* Sharing, one person at a time. A personal link (card#s=…) carries what the owner chose to share
   this time: p phone, w WhatsApp, e email, l LinkedIn. The card then shows only those, and "Save
   contact" builds the contact on the visitor's phone (with the photo) instead of using card.vcf.
   The link lives in the part after #, which never reaches the server. */
var CARD = {{ card_json | tojson }}, UI = {{ ui | tojson }};
function shareEncode(o) { return btoa(unescape(encodeURIComponent(JSON.stringify(o)))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''); }
function shareDecode(t) {
  try { var o = JSON.parse(decodeURIComponent(escape(atob(t.replace(/-/g, '+').replace(/_/g, '/'))))); return o && typeof o === 'object' ? o : null; }
  catch (e) { return null; }
}
(function () {
  var m = /^#s=([\w-]+)/.exec(location.hash);
  var share = m && shareDecode(m[1]);
  if (!share) return;
  var num = String(share.p || '').trim(), digits = num.replace(/\D/g, '');
  var on = { p: !!(num && share.t), w: !!(digits && share.w), e: !!share.e, l: !!share.l };
  Array.prototype.forEach.call(document.querySelectorAll('[data-share]'), function (n) { n.hidden = !on[n.getAttribute('data-share')]; });
  var row = document.getElementById('phone-row');
  row.hidden = !(on.p || on.w);
  if (on.p) { var tel = document.getElementById('tel'); tel.href = 'tel:' + num.replace(/[^\d+]/g, ''); tel.querySelector('span').textContent = num; }
  if (on.w) document.getElementById('wa').href = 'https://wa.me/' + digits;
  if (on.p !== on.w) row.style.gridTemplateColumns = '1fr';
  function esc(s) { return String(s).replace(/\\/g, '\\\\').replace(/,/g, '\\,').replace(/;/g, '\\;').replace(/\n/g, '\\n'); }
  function fold(l) { var out = [l.slice(0, 75)]; for (var i = 75; i < l.length; i += 74) out.push(' ' + l.slice(i, i + 74)); return out.join('\r\n'); }
  function vcard(photo) {
    var L = ['BEGIN:VCARD', 'VERSION:3.0', 'N:' + esc(CARD.last) + ';' + esc(CARD.first) + ';;;', 'FN:' + esc(CARD.name),
             'TITLE:' + esc(CARD.title), 'URL:' + CARD.site];
    if (on.e && CARD.email) L.push('EMAIL;TYPE=INTERNET:' + CARD.email);
    if (on.p) L.push('TEL;TYPE=CELL:' + num.replace(/[^\d+]/g, ''));
    if (on.w) L.push('X-SOCIALPROFILE;TYPE=whatsapp:https://wa.me/' + digits);
    if (on.l) (CARD.socials || []).forEach(function (s) { L.push('X-SOCIALPROFILE;TYPE=' + esc(String(s.label || '').toLowerCase()) + ':' + s.url); });
    if (photo) L.push('PHOTO;ENCODING=b;TYPE=JPEG:' + photo);
    L.push('NOTE:' + esc(CARD.note), 'END:VCARD');
    return L.map(fold).join('\r\n') + '\r\n';
  }
  var save = document.getElementById('save');
  function use(photo) { save.href = URL.createObjectURL(new Blob([vcard(photo)], { type: 'text/vcard;charset=utf-8' })); }
  use(''); // ready at once; the photo follows a moment later
  if (CARD.photo && window.FileReader) fetch(CARD.photo).then(function (r) { return r.ok ? r.blob() : null; }).then(function (b) {
    if (!b) return;
    var fr = new FileReader();
    fr.onload = function () { use(String(fr.result).split(',')[1] || ''); };
    fr.readAsDataURL(b);
  }).catch(function () {});
})();
/* The owner's share panel: on a device signed in to /admin (or the Photos page) with a sign-in that
   can change the site. Tick what to share, then show a QR code for a personal link, or send the link.
   It always starts with phone, email and LinkedIn ticked. The number is kept on this device only
   (localStorage), never in the site. */
(function () {
  var REPO = {{ edit.repo | tojson }};
  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function put(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function token() {
    var keys = ['uploadAuth', 'decap-cms-user', 'netlify-cms-user'];
    for (var i = 0; i < keys.length; i++) { try { var u = JSON.parse(get(keys[i]) || 'null'); if (u && u.token) return u.token; } catch (e) {} }
    return '';
  }
  var tok = token();
  if (!tok || !window.fetch) return;
  var form = document.getElementById('owner'), phone = document.getElementById('owner-phone'),
      status = document.getElementById('owner-status'), boxes = form.querySelectorAll('.picks input');
  fetch('https://api.github.com/repos/' + REPO, { cache: 'no-store', headers: { Authorization: 'Bearer ' + tok, Accept: 'application/vnd.github+json' } })
    .then(function (r) { return r.ok ? r.json() : null; }).then(function (repo) {
      if (!repo || !repo.permissions || !repo.permissions.push) return; // a sign-in that can't change the site
      phone.value = get('cardSharePhone') || '';
      var last = ['p', 'e', 'l']; // the standard choice: phone, email, LinkedIn
      Array.prototype.forEach.call(boxes, function (b) { b.checked = last.indexOf(b.value) >= 0; });
      form.hidden = false;
    }).catch(function () {});
  function choice() {
    var o = {}, picked = [];
    Array.prototype.forEach.call(boxes, function (b) { if (b.checked) { picked.push(b.value); o[b.value === 'p' ? 't' : b.value] = 1; } });
    var num = phone.value.trim();
    if ((o.t || o.w) && !num) { status.textContent = UI.needPhone; phone.focus(); return null; }
    if (o.t || o.w) o.p = num;
    put('cardSharePhone', num);
    var names = picked.map(function (k) { return UI.pick[k]; });
    status.textContent = '';
    return { url: CARD.site + 'card#s=' + shareEncode(o), what: UI.sharing + (names.length ? names.join(', ') : UI.nothing) };
  }
  var qrLib = null;
  function lib() {
    if (window.qrcode) return Promise.resolve(window.qrcode);
    return qrLib || (qrLib = new Promise(function (ok, no) {
      var s = document.createElement('script'); s.src = 'assets/card/qrcode.js';
      s.onload = function () { ok(window.qrcode); }; s.onerror = no; document.head.appendChild(s);
    }));
  }
  /* the same night look as assets/card/qr.svg: light squares on navy, ember-eyed corners, the eye in the middle */
  function svgFor(url) {
    var q = window.qrcode(0, 'H'); q.addData(url); q.make();
    var n = q.getModuleCount(), d = '', c = n / 2, hole = Math.ceil(n * 0.21) / 2;
    function finder(x, y) { return (x < 7 && y < 7) || (x >= n - 7 && y < 7) || (x < 7 && y >= n - 7); }
    for (var y = 0; y < n; y++) for (var x = 0; x < n; x++) {
      if (!q.isDark(y, x) || finder(x, y) || (Math.abs(x + .5 - c) < hole && Math.abs(y + .5 - c) < hole)) continue;
      d += 'M' + x + ' ' + y + 'h1v1h-1z';
    }
    var eyes = [[0, 0], [n - 7, 0], [0, n - 7]].map(function (p) {
      return '<path d="M' + p[0] + ' ' + p[1] + 'h7v7h-7zM' + (p[0] + 1) + ' ' + (p[1] + 1) + 'v5h5v-5z" fill="#f6f1e7" fill-rule="evenodd"/>' +
             '<rect x="' + (p[0] + 2) + '" y="' + (p[1] + 2) + '" width="3" height="3" fill="#e39a5c"/>';
    }).join('');
    var s = hole * 2 * 0.88, k = s / 100;
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + (n + 8) + ' ' + (n + 8) + '"><rect width="' + (n + 8) + '" height="' + (n + 8) + '" fill="#0b1322"/>' +
      '<g transform="translate(4,4)"><path d="' + d + '" fill="#f6f1e7"/>' + eyes +
      '<g transform="translate(' + (c - s / 2) + ',' + (c - s / 2) + ') scale(' + k + ')"><path d="M6 50Q50 6 94 50Q50 94 6 50Z" fill="none" stroke="#f6f1e7" stroke-width="7" stroke-linejoin="round"/>' +
      '<circle cx="50" cy="50" r="15" fill="#e39a5c"/><circle cx="45" cy="45" r="4" fill="#fff5e8" opacity=".85"/></g></g></svg>';
  }
  var code = document.querySelector('#qr .code'), hint = document.getElementById('qr-hint'),
      plainCode = code.innerHTML, plainHint = hint.textContent;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var c = choice(); if (!c) return;
    lib().then(function () {
      code.innerHTML = svgFor(c.url); hint.textContent = c.what;
      location.hash = 'qr';
    }).catch(function () { status.textContent = 'QR: offline?'; });
  });
  window.addEventListener('hashchange', function () { // the plain card's code comes back when the screen closes
    if (location.hash !== '#qr') { code.innerHTML = plainCode; hint.textContent = plainHint; }
  });
  document.getElementById('owner-send').addEventListener('click', function () {
    var c = choice(); if (!c) return;
    if (navigator.share) navigator.share({ title: CARD.name, url: c.url }).catch(function () {});
    else if (navigator.clipboard) navigator.clipboard.writeText(c.url).then(function () { status.textContent = UI.copied; });
    else status.textContent = c.url;
  });
})();
/* While the QR is showing, ask the phone to keep the screen awake. */
(function () {
  var lock = null;
  function sync() {
    if (location.hash === '#qr' && 'wakeLock' in navigator) navigator.wakeLock.request('screen').then(function (l) { lock = l; }).catch(function () {});
    else if (lock) { lock.release(); lock = null; }
  }
  window.addEventListener('hashchange', sync); sync();
})();
</script>
</body>
</html>
