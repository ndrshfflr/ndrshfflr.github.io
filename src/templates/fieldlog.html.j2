{% extends "world.html.j2" %}
{#- The field log (fieldlog.html / fieldlog.da.html), standing in the circle's
    world. Finds come from content/observations.json (synced nightly) and
    content/fieldlog.json (your choices in /admin: favourites, photos, stories,
    hand-added finds…); assets/fieldlog.js combines them in the browser. -#}
{% block styles %}<link rel="stylesheet" href="assets/fieldlog.css?v={{ v.fieldlogcss }}">{% endblock %}
{% block content %}
  <div class="hero chrome log-hero">
    <span class="log-rune" aria-hidden="true">{{ rune }}</span>
    <p class="log-eyebrow"><span class="rv" data-k="eyebrow"><span class="rn" aria-hidden="true"></span><span class="lt">{{ t.eyebrow }}</span></span></p>
    <h1 class="nm"><span class="rv" data-k="heading"><span class="rn" aria-hidden="true"></span><span class="lt">{{ t.heading }}</span></span></h1>
    <p class="title log-intro"><span class="rv" data-k="intro"><span class="rn" aria-hidden="true"></span><span class="lt">{{ t.intro }}</span></span></p>
    <button class="aa" id="aa" type="button" aria-pressed="false" aria-label="{{ ui.aa }}">Aa</button>
    <dl class="fl-stats" id="fl-stats" hidden>
      <div><dt><span class="rv" data-k="st-species"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.flSpecies }}</span></span></dt><dd id="fl-stat-species">0</dd></div>
      <div><dt><span class="rv" data-k="st-records"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.flRecords }}</span></span></dt><dd id="fl-stat-records">0</dd></div>
      <div><dt><span class="rv" data-k="st-year"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.flThisYear }}</span></span></dt><dd id="fl-stat-year">0</dd></div>
    </dl>
  </div>

  <main class="log-wrap" id="main">
    <div class="fl-goals" id="fl-goals" hidden></div>
    <div class="fl-tools" id="fl-tools" hidden>
      <div class="fl-chips" id="fl-chips" role="group" aria-label="{{ ui.flFilter }}"></div>
      <div class="fl-controls">
        <label class="fl-search"><span class="sr-only">{{ ui.flSearch }}</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
          <input type="search" id="fl-search" placeholder="{{ ui.flSearch }}" autocomplete="off" enterkeyhint="search"></label>
        <label class="fl-sort"><span class="sr-only">{{ ui.flSortLabel }}</span>
          <select id="fl-sort">
            <option value="latest">{{ ui.flSortLatest }}</option>
            <option value="number">{{ ui.flSortNumber }}</option>
            <option value="newest">{{ ui.flSortNewest }}</option>
            <option value="az">{{ ui.flSortAz }}</option>
            <option value="most">{{ ui.flSortMost }}</option>
          </select></label>
      </div>
    </div>
    <p class="fl-empty" id="fl-empty"><span class="rv" data-k="loading"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.loading }}</span></span></p>
    <p class="fl-empty" id="fl-nomatch" hidden><span class="rv" data-k="nomatch"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.flNoMatch }}</span></span></p>
    <ol class="fl-grid" id="fl-grid"></ol>
    <p class="fl-sync" id="fl-sync" hidden></p>
    <noscript><p class="fl-empty">{{ t.emptyText }}</p></noscript>
  </main>

  <footer class="world-foot chrome">
    <a class="back-link" href="{{ entry_href }}"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg><span class="rv" data-k="back"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.back }}</span></span></a>
  </footer>

  <dialog class="fl-dialog" id="fl-dialog" aria-labelledby="fl-d-name">
    <button class="fl-d-close" id="fl-d-close" type="button" aria-label="{{ ui.close }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    <div class="fl-d-inner">
      <div class="fl-d-photos" id="fl-d-photos"></div>
      <div class="fl-d-body">
        <p class="fl-d-no" id="fl-d-no"></p>
        <h2 class="fl-d-name" id="fl-d-name"></h2>
        <p class="fl-d-common" id="fl-d-common"></p>
        <p class="fl-d-group" id="fl-d-group"></p>
        <a class="fl-d-story" id="fl-d-story" href="#" hidden><span class="fl-d-story-rune" aria-hidden="true">ᚬ</span><span class="rv" data-k="readAbout"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.flReadAbout }}</span></span></a>
        <div class="fl-d-notes" id="fl-d-notes"></div>
        <div id="fl-d-blog" hidden>
          <h3 class="fl-d-recs-h"><span class="rv" data-k="fromBlog"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.flFromBlog }}</span></span></h3>
          <ul class="fl-d-posts" id="fl-d-posts"></ul>
        </div>
        <h3 class="fl-d-recs-h"><span class="rv" data-k="records"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.flRecords }}</span></span></h3>
        <ul class="fl-d-recs" id="fl-d-recs"></ul>
      </div>
    </div>
  </dialog>
{% endblock %}
{% block scripts %}
<script id="fl-data" type="application/json">{{ data | tojson }}</script>
<script src="assets/fieldlog.js?v={{ v.fieldlog }}"></script>
{% endblock %}
