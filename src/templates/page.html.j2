{% extends "world.html.j2" %}
{#- The CV and other extra pages (page.html?slug=cv / page.da.html?slug=cv): the
    markdown in content/pages/<slug>.md (/admin → Extra Pages), read in the
    browser. The CV gets a "Download as PDF" button (cv.pdf). -#}
{% block styles %}<link rel="stylesheet" href="assets/pages.css?v={{ v.pagescss }}">{% endblock %}
{% block content %}
  <div class="hero chrome pg-hero">
    <span class="pg-rune" aria-hidden="true">{{ rune }}</span>
    <h1 class="nm pg-title"><span class="rv" data-k="page-title"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.loading }}</span></span></h1>
    <p class="pg-actions" id="pg-actions" hidden><a class="pg-btn" href="cv.pdf" download>{{ ui.downloadPdf }}</a></p>
    <button class="aa" id="aa" type="button" aria-pressed="false" aria-label="{{ ui.aa }}">Aa</button>
  </div>

  <main class="pg-wrap" id="main" data-page="page">
    <article class="pg-paper">
      <div class="pg-body" id="pg-body"><p class="pg-loading">{{ ui.loading }}</p></div>
    </article>
  </main>

  <footer class="world-foot chrome">
    <a class="back-link" href="{{ entry_href }}"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg><span class="rv" data-k="back"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.back }}</span></span></a>
  </footer>
{% endblock %}
{% block scripts %}
<script src="assets/markdown.js?v={{ v.md }}"></script>
<script src="assets/pages.js?v={{ v.pagesjs }}"></script>
{% endblock %}
