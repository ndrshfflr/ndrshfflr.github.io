{% extends "base.html.j2" %}
{% block main %}
<header class="page-header">
  <div class="wrap">
    <div class="print-only print-id">Pieter Shiffler Carpentier · {{ d.contact.email }} · ndrshfflr.github.io</div>
    <h1 id="page-title">&nbsp;</h1>
    <div class="page-actions" id="page-actions" hidden>
      <a class="btn btn-ghost" id="page-pdf" href="cv.pdf" download>{{ ui.downloadPdf }}</a>
    </div>
  </div>
</header>
<div class="carve" aria-hidden="true"></div>
<div class="wrap">
  <div class="page-body" id="page-body">
    <p class="page-loading">{{ ui.loading }}</p>
  </div>
  <a class="page-back" href="{{ home_href }}">&larr; {{ ui.back }}</a>
</div>
{% endblock %}

{% block scripts %}
<script>
// --- Tiny, dependency-free markdown renderer: headings, paragraphs, bold,
// italic, links, images, and simple lists. Enough for a personal page —
// not a full CommonMark implementation. ---
(function () {
  function escapeHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function inline(text) {
    let t = escapeHtml(text);
    t = t.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">');
    t = t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
    t = t.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    t = t.replace(/\*([^*]+)\*/g, '<em>$1</em>');
    return t;
  }
  function renderMarkdown(md) {
    const lines = md.replace(/\r\n/g, '\n').split('\n');
    let html = '';
    let i = 0;
    while (i < lines.length) {
      let line = lines[i];
      if (/^\s*$/.test(line)) { i++; continue; }
      let m = line.match(/^(#{1,3})\s+(.*)$/);
      if (m) {
        const level = m[1].length + 1; // page's own <h1> is the title, so # -> h2
        html += `<h${level}>${inline(m[2])}</h${level}>\n`;
        i++; continue;
      }
      if (/^\s*[-*]\s+/.test(line)) {
        html += '<ul>\n';
        while (i < lines.length && /^\s*[-*]\s+/.test(lines[i])) {
          html += `<li>${inline(lines[i].replace(/^\s*[-*]\s+/, ''))}</li>\n`;
          i++;
        }
        html += '</ul>\n';
        continue;
      }
      if (/^\s*\d+\.\s+/.test(line)) {
        html += '<ol>\n';
        while (i < lines.length && /^\s*\d+\.\s+/.test(lines[i])) {
          html += `<li>${inline(lines[i].replace(/^\s*\d+\.\s+/, ''))}</li>\n`;
          i++;
        }
        html += '</ol>\n';
        continue;
      }
      let para = [line];
      i++;
      while (i < lines.length && !/^\s*$/.test(lines[i]) && !/^(#{1,3})\s+/.test(lines[i]) && !/^\s*[-*]\s+/.test(lines[i]) && !/^\s*\d+\.\s+/.test(lines[i])) {
        para.push(lines[i]);
        i++;
      }
      html += `<p>${inline(para.join(' '))}</p>\n`;
    }
    return html;
  }
  function parseFrontmatter(text) {
    const match = text.match(/^---\s*([\s\S]*?)\s*---\s*([\s\S]*)$/);
    if (!match) return { meta: {}, body: text };
    const meta = {};
    match[1].split('\n').forEach(line => {
      const kv = line.match(/^([a-zA-Z0-9_]+):\s*(.*)$/);
      if (kv) meta[kv[1]] = kv[2].trim().replace(/^["']|["']$/g, '');
    });
    return { meta, body: match[2] };
  }

  const ui = JSON.parse(document.getElementById('ui-strings').textContent);
  const params = new URLSearchParams(window.location.search);
  const slug = params.get('slug');
  const titleEl = document.getElementById('page-title');
  const bodyEl = document.getElementById('page-body');

  if (slug === 'cv') document.getElementById('page-actions').hidden = false;

  if (!slug) {
    titleEl.textContent = ui.notFound;
    bodyEl.innerHTML = '<p>' + ui.notFoundBody + '</p>';
  } else {
    fetch(`content/pages/${slug}.md`)
      .then(res => { if (!res.ok) throw new Error('not found'); return res.text(); })
      .then(text => {
        const { meta, body } = parseFrontmatter(text);
        document.title = (meta.title || slug) + ' — Pieter Shiffler Carpentier';
        titleEl.textContent = meta.title || slug;
        bodyEl.innerHTML = renderMarkdown(body);
      })
      .catch(() => {
        titleEl.textContent = ui.notFound;
        bodyEl.innerHTML = '<p>' + ui.notFoundBody + '</p>';
      });
  }
})();
</script>
{% endblock %}
