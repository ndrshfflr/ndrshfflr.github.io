{% extends "base.html.j2" %}
{% block main %}
<header class="page-header">
  <div class="wrap">
    <div class="eyebrow"><span class="rune" aria-hidden="true" title="{{ runes.exploration.title }}">{{ runes.exploration.glyph }}</span><span id="exploration-eyebrow">{{ d.exploration.eyebrow }}</span></div>
    <h1 id="exploration-heading">{{ d.exploration.heading }}</h1>
  </div>
</header>
<div class="carve" aria-hidden="true"></div>
<div class="wrap">
  <div class="page-body">
    <p id="exploration-intro">{{ d.exploration.intro }}</p>
    <p id="exploration-body">{{ d.exploration.body }}</p>
    <p class="egg-glyph-row"><button class="egg-glyph" type="button" data-egg aria-label="{{ ui.eggTitle }}" title="…">⁂</button></p>
  </div>
  <a class="page-back" href="{{ entry_href }}">&larr; {{ ui.back }}</a>
</div>
{% endblock %}
