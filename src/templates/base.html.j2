<!DOCTYPE html>
<!-- GENERATED FILE — built by src/build.py from src/templates/. Text content is
     also loaded live from content/*.json (edited through /admin), so most
     wording changes never need a rebuild. -->
<html lang="{{ lang }}" data-theme="dark">
<head>
<script>
(function () {
  try {
    var stored = localStorage.getItem('theme');
    var theme = (stored === 'light' || stored === 'dark') ? stored : 'dark';
    document.documentElement.setAttribute('data-theme', theme);
  } catch (e) {
    document.documentElement.setAttribute('data-theme', 'dark');
  }
})();
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
{% if meta.canonical %}<link rel="canonical" href="{{ meta.canonical }}">{% endif %}
{% for alt in meta.alternates %}<link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}">
{% endfor %}
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link rel="icon" type="image/x-icon" href="favicon.ico">
<link rel="apple-touch-icon" href="apple-touch-icon.png">

<meta property="og:type" content="website">
<meta property="og:site_name" content="Pieter Shiffler Carpentier">
<meta property="og:title" content="{{ meta.title }}">
<meta property="og:description" content="{{ meta.ogDescription }}">
{% if meta.canonical %}<meta property="og:url" content="{{ meta.canonical }}">{% endif %}
<meta property="og:locale" content="{{ 'da_DK' if lang == 'da' else 'en_GB' }}">
<meta property="og:image" content="{{ site_url }}og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta.title }}">
<meta name="twitter:description" content="{{ meta.ogDescription }}">
<meta name="twitter:image" content="{{ site_url }}og-image.png">
{% block jsonld %}{% endblock %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="preload" href="assets/fonts/skurd.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="styles.css">
<!-- Cloudflare Web Analytics — free, cookie-free visitor counts. Replace the
     token below with your own from the Cloudflare dashboard (see setup guide). -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "REPLACE-WITH-YOUR-CF-ANALYTICS-TOKEN"}'></script>
</head>
<body class="{{ body_class }}">
<a class="skip-link" href="#main">{{ ui.skip }}</a>

<nav id="site-nav">
  <div class="wrap">
    <div class="brand mark">
      <button class="egg-trigger" type="button" data-egg aria-label="{{ ui.eggTitle }}" title="…">
        <svg viewBox="0 0 48 32" aria-hidden="true">
          <path d="M4 20C4 10 14 4 24 4C34 4 44 10 44 20C44 20 34 16 24 16C14 16 4 20 4 20Z" fill="var(--accent-2)"/>
          <rect x="20" y="16" width="8" height="14" rx="3" fill="var(--text)"/>
          <ellipse cx="24" cy="30" rx="9" ry="2" fill="var(--text-soft)" opacity=".35"/>
        </svg>
      </button>
      <a href="{{ home_href }}#top" class="brand-name">Pieter Shiffler Carpentier</a>
    </div>
    <div class="nav-right">
      <div class="navlinks" id="navlinks">
        <a href="{{ home_href }}#about" id="nav-label-about">{{ d.nav.about }}</a>
        <a href="{{ home_href }}#microbiology" id="nav-label-microbiology">{{ d.nav.microbiology }}</a>
        <a href="{{ home_href }}#projects" id="nav-label-projects">{{ d.nav.projects }}</a>
        <a href="{{ home_href }}#mycology" id="nav-label-mycology">{{ d.nav.mycology }}</a>
        <span id="nav-dynamic" class="nav-dynamic"></span>
        <a href="{{ home_href }}#contact" id="nav-label-contact">{{ d.nav.contact }}</a>
      </div>
      <a class="lang-switch" href="{{ other_lang_href }}" hreflang="{{ ui.otherLang }}" lang="{{ ui.otherLang }}" data-lang-switch>{{ ui.otherLangLabel }}</a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="{{ ui.themeToggle }}">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/>
        </svg>
      </button>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-label="{{ ui.menu }}" aria-expanded="false" aria-controls="navlinks">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<main id="main">
{% block main %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="wrap footer-row">
    <div>© <span id="year">{{ year }}</span> Pieter Shiffler Carpentier<span id="footer-cvr" class="footer-cvr"{% if not d.business.cvr %} hidden{% endif %}> · CVR <span id="footer-cvr-value">{{ d.business.cvr }}</span></span></div>
    <div class="footer-links">
      <a href="{{ exploration_href }}" id="footer-exploration">{{ d.footer.explorationLabel }}</a>
      <a href="{{ other_lang_href }}" hreflang="{{ ui.otherLang }}" lang="{{ ui.otherLang }}" data-lang-switch>{{ ui.otherLangName }}</a>
    </div>
    <div id="footer-tagline">{{ d.footer.tagline }}</div>
    <div class="runes footer-runes" aria-hidden="true" title="{{ ui.nameRunesTitle }}">{{ name_runes }}</div>
  </div>
</footer>

<div class="egg" id="egg" hidden role="dialog" aria-modal="true" aria-label="{{ ui.eggTitle }}">
  <div class="egg-stage" id="egg-stage"></div>
  <div class="egg-veil"></div>
  <div class="egg-copy">
    <div class="eyebrow"><span class="rune" aria-hidden="true">ᛜ</span>{{ ui.eggEyebrow }}</div>
    <div class="egg-title">{{ ui.eggTitle }}</div>
  </div>
  <div class="egg-bottom">
    <button class="motion-btn" id="motion-btn" type="button">{{ ui.enableMotion }}</button>
    <div id="egg-hint">{{ ui.eggHint }}</div>
  </div>
  <button class="egg-close" id="egg-close" type="button" aria-label="{{ ui.close }}">&times;</button>
  <p class="egg-fallback" id="egg-fallback" hidden>{{ ui.eggFallback }}</p>
</div>

<script id="ui-strings" type="application/json">{{ ui | tojson }}</script>
{% block scripts %}{% endblock %}
<script src="assets/site.js" defer></script>
</body>
</html>
