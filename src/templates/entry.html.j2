{%- endif -%}
{%- endmacro -%}
{%- macro season_icon(s) -%}
{%- if s == 'winter' -%}<path d="M12 2v20M3.3 7l17.4 10M3.3 17L20.7 7M9 3.5l3 2 3-2M9 20.5l3-2 3 2"/>
{%- elif s == 'spring' -%}<path d="M12 21V11M12 11C12 7 9 5 5 5c0 4 3 6 7 6zM12 14c0-3 2.5-5 6-5 0 3-2.5 5-6 5z"/>
{%- elif s == 'summer' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
{%- elif s == 'autumn' -%}<path d="M5 19C5 11 10 5 19 5c0 9-6 14-14 14zM5 19l8-8"/>
{%- else -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- endif -%}
{%- endmacro -%}
<!DOCTYPE html>
<!-- GENERATED FILE — built by src/build.py from src/templates/entry.html.j2.
     Wording comes from content/entry.json and content/entry.da.json (edited
