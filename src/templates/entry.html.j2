{% extends "world.html.j2" %}
{#- The stone circle of portals (index.html / da.html). Wording comes from
    content/entry.json and content/entry.da.json (edited through /admin) and is
    also loaded live by assets/entry.js. -#}
{% block styles %}<link rel="stylesheet" href="assets/entry.css?v={{ v.entrycss }}">{% endblock %}
{% block content %}
{%- from "_portal_drawings.j2" import drawing %}
  <div class="hero chrome">
    <h1 class="nm"><span class="rv" data-k="name"><span class="rn" aria-hidden="true"></span><span class="lt">{{ e.name }}</span></span></h1>
    <p class="title"><span class="rv" data-k="title"><span class="rn" aria-hidden="true"></span><span class="lt">{{ e.title }}</span></span></p>
    <button class="aa" id="aa" type="button" aria-pressed="false" aria-label="{{ ui.aa }}">Aa</button>
  </div>

  <main class="ring-wrap" id="main">
    <nav class="ring-nav" id="ring-nav" aria-label="{{ ui.worlds }}">
      <div class="stage cam" id="stage">
        <svg class="treeline" id="inscription" viewBox="0 0 1877 250" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
          <defs><pattern id="bark-pat" width="54" height="68" patternUnits="userSpaceOnUse"><rect width="54" height="68" class="bark-base"/><g class="bark-marks"><rect x="9.4" y="6.8" width="10.1" height="1.6"/><rect x="2.7" y="26.5" width="16.9" height="2.7"/><rect x="30.6" y="14.6" width="12" height="1.8"/><rect x="6.9" y="7" width="7.8" height="2.9"/><rect x="33.2" y="53.2" width="15.4" height="1.7"/><rect x="12.4" y="41.4" width="14.5" height="2.8"/><rect x="35.2" y="5.7" width="12.9" height="2.5"/><rect x="20.2" y="11.7" width="11.2" height="1.5"/><rect x="37.4" y="57.1" width="12.1" height="1.9"/><rect x="36.4" y="37.8" width="16.5" height="2.8"/><rect x="20.3" y="27.3" width="12.8" height="2.1"/><rect x="0" y="48.6" width="8.5" height="2.2"/><rect x="24.5" y="62.2" width="9.8" height="2.4"/></g></pattern></defs>
          {#- The carved inscription. _inscription.html holds the hand-tuned drawing of
              ᛏᚢ᛬ᚦᛅ᛬ᛘᛅᛁᛏ᛬ᚦᛅᛏ᛬ᛁᛋ᛬ᛋᛏᛁᛚ᛬ᚦᛅ᛬ᛁᚢᚾᛁᚠᛁᚱᛋ᛬ᛋᛅᚱᛁᛏᛅᛋ; if the text in
              content/entry.json is changed, assets/entry.js carves the new text instead. #}
          <g id="inscription-runes" fill="none" stroke="url(#bark-pat)" stroke-linecap="butt" stroke-linejoin="miter" data-carved="ᛏᚢ᛬ᚦᛅ᛬ᛘᛅᛁᛏ᛬ᚦᛅᛏ᛬ᛁᛋ᛬ᛋᛏᛁᛚ᛬ᚦᛅ᛬ᛁᚢᚾᛁᚠᛁᚱᛋ᛬ᛋᛅᚱᛁᛏᛅᛋ">
{% include '_inscription.html' %}</g>
        </svg>
        <span class="pool" aria-hidden="true"></span>
        <div class="scene">
          <div class="floor" id="floor" aria-hidden="true">
            <span class="floor-ring1"></span><span class="floor-ring2"></span>
            <span class="floor-fx" id="floor-winter"></span><span class="floor-fx" id="floor-summer"></span>
          </div>
          {% for p in e.portals %}{% set r = ring[loop.index0] %}
          <div class="item" data-i="{{ loop.index0 }}" style="transform:{{ r.t }}">
            <a class="pd{% if loop.first %} on{% endif %}" href="{{ p.link or '#' }}" data-i="{{ loop.index0 }}" aria-label="{{ p.name }}" style="opacity:{{ r.o }}">
              <span class="pa">
                <span class="core" aria-hidden="true"></span>
                <span class="lens" aria-hidden="true"><svg class="grid" viewBox="-100 -100 200 200"><g class="flow"><circle r="126"/><circle r="92"/><circle r="67"/><circle r="49"/><circle r="36"/><circle r="26"/><circle r="19"/><circle r="14"/><circle r="10"/><circle r="7.4"/></g><g class="spokes"><path d="M0-100V100M-100 0H100M-71-71L71 71M71-71L-71 71M-38-92L38 92M38-92L-38 92M-92-38L92 38M92-38L-92 38"/></g></svg>{{ drawing(p.key) }}</span>
                <span class="wv w1" aria-hidden="true"></span><span class="wv w2" aria-hidden="true"></span><span class="wv w3" aria-hidden="true"></span>
                <span class="pr" aria-hidden="true">{{ p.rune }}</span>
              </span>
              <span class="beam" aria-hidden="true"></span><span class="foot" aria-hidden="true"></span>
              <span class="pl" style="opacity:{{ r.lo }}"><span class="rv" data-k="portal-{{ loop.index0 }}"><span class="rn" aria-hidden="true"></span><span class="lt">{{ p.name }}</span></span></span>
            </a>
          </div>
          {% endfor %}
        </div>
      </div>
      <div class="controls chrome">
        <button class="ctl" id="prev" type="button" aria-label="{{ ui.prev }}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <div class="dots" role="group" aria-label="{{ ui.choosePortal }}">
          {% for p in e.portals %}<button class="dot{% if loop.first %} on{% endif %}" type="button" data-i="{{ loop.index0 }}" aria-label="{{ p.name }}" aria-current="{{ 'true' if loop.first else 'false' }}">{{ p.rune }}</button>{% endfor %}
        </div>
        <button class="ctl" id="next" type="button" aria-label="{{ ui.next }}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
      <p class="sr-only" id="live" aria-live="polite"></p>
    </nav>
  </main>

  <nav class="small-menu chrome" aria-label="{{ ui.notesTools }}">
    <svg class="chip" aria-hidden="true" width="100%" height="14"><defs><pattern id="chip" width="20" height="14" patternUnits="userSpaceOnUse"><path d="M0 13L10 1L20 13" fill="none" stroke="currentColor" stroke-width="1"/><path d="M6 13L10 8L14 13" fill="none" stroke="currentColor" stroke-width="1"/></pattern></defs><rect width="100%" height="14" fill="url(#chip)"/></svg>
    <ul>
      {% for m in e.menu %}{% if not loop.first %}<li class="dia" aria-hidden="true">◆</li>{% endif %}<li><a class="sm" href="{{ m.link }}" data-m="{{ loop.index0 }}" aria-label="{{ m.name }}"><span class="mr" aria-hidden="true">{{ m.rune }}</span><span class="rv" data-k="menu-{{ loop.index0 }}"><span class="rn" aria-hidden="true"></span><span class="lt">{{ m.name }}</span></span></a></li>{% endfor %}
    </ul>
  </nav>

  <section class="dest" id="dest" hidden>
    <span class="dest-rune" id="dest-rune" aria-hidden="true"></span>
    <h2 class="dest-name"><span class="rv" data-k="dest-name"><span class="rn" aria-hidden="true"></span><span class="lt"></span></span></h2>
    <p class="dest-note"><span class="rv" data-k="dest-note"><span class="rn" aria-hidden="true"></span><span class="lt"></span></span></p>
    <button class="dest-back" id="dest-back" type="button"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg><span class="rv" data-k="dest-back"><span class="rn" aria-hidden="true"></span><span class="lt"></span></span></button>
  </section>
{% endblock %}
{% block scripts %}
<script id="entry-data" type="application/json">{{ data | tojson }}</script>
<script src="assets/entry.js?v={{ v.entryjs }}"></script>
{% endblock %}
