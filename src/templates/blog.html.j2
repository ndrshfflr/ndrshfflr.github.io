{% extends "world.html.j2" %}
{#- The Labdiary (blog.html / blog.da.html), in the circle's world. Posts are
    content/posts/*.md, written in /admin → Blog posts; the line under the
    heading is the Blog intro in /admin → Classic Page. -#}
{% block styles %}<link rel="stylesheet" href="assets/pages.css?v={{ v.pagescss }}">{% endblock %}
{% block content %}
  <div class="hero chrome pg-hero">
    <span class="pg-rune" aria-hidden="true">{{ rune }}</span>
    <h1 class="nm"><span class="rv" data-k="heading"><span class="rn" aria-hidden="true"></span><span class="lt">{{ heading }}</span></span></h1>
    {% if b.intro %}<p class="title"><span class="rv" data-k="intro"><span class="rn" aria-hidden="true"></span><span class="lt">{{ b.intro }}</span></span></p>{% endif %}
    <button class="aa" id="aa" type="button" aria-pressed="false" aria-label="{{ ui.aa }}">Aa</button>
  </div>

  <main class="pg-wrap pg-wide" id="main" data-page="labdiary">
    {% if tags | length > 1 %}<div class="pg-tags" id="pg-tags" role="group" aria-label="{{ ui.filterTags }}">
      <button type="button" class="pg-tag" data-tag="" aria-pressed="true">{{ ui.allPosts }}</button>
      {% for t in tags %}<button type="button" class="pg-tag" data-tag="{{ t }}" aria-pressed="false">{{ t }}</button>{% endfor %}
    </div>{% endif %}
    <ul class="pg-posts" id="pg-posts">
      {% for p in posts %}<li class="pg-card"{% if p.tags %} data-tags="{{ p.tags | join('|') }}"{% endif %}>
        <a class="pg-card-a" href="{{ post_href }}?slug={{ p.slug }}"{% if p.language and p.language != lang %} hreflang="{{ p.language }}"{% endif %}>
          <span class="pg-cover">{% if p.cover %}<img src="{{ p.cover }}" alt="" loading="lazy" decoding="async">{% else %}<span class="pg-cover-rune" aria-hidden="true">{{ rune }}</span>{% endif %}</span>
          <span class="pg-card-text">
            <span class="pg-meta"><time datetime="{{ p.date_iso }}">{{ p.date_label[lang] }}</time>{% if p.language and p.language != lang %}<span class="pg-lang">{{ p.language | upper }}</span>{% endif %}</span>
            <span class="pg-card-title">{{ p.title }}</span>
            {% if p.summary %}<span class="pg-summary">{{ p.summary }}</span>{% endif %}
            {% if p.tags %}<span class="pg-card-tags">{% for t in p.tags %}<span>{{ t }}</span>{% endfor %}</span>{% endif %}
          </span>
        </a>
      </li>{% endfor %}
    </ul>
    <p class="pg-empty"{% if posts %} hidden{% endif %}>{{ b.emptyText }}</p>
  </main>

  <footer class="world-foot chrome">
    <a class="back-link" href="{{ entry_href }}"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg><span class="rv" data-k="back"><span class="rn" aria-hidden="true"></span><span class="lt">{{ ui.back }}</span></span></a>
  </footer>
{% endblock %}
{% block scripts %}<script src="assets/pages.js?v={{ v.pagesjs }}"></script>{% endblock %}
