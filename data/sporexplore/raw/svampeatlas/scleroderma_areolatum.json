   "attributes": {
    "taxon_id": 20216,
    "createdAt": "2015-09-17T10:10:03.000Z",
    "updatedAt": "2018-03-12T09:40:45.000Z",
    "diagnose": "en lille bruskbold med ret tydelig, men ret kort, rodagtig stokdel, et tyndt peridium og meget tydelige, små, regelmæssige, mørke, tiltrykte peridieskæl på en lyst gulbrun baggrund. Uden øskner i peridiet. De ret kortpiggede sporer måler 10-13 µm uden ornament.",
    "beskrivelse": "",
    "forvekslingsmuligheder": "Stilket bruskbold (S. verrucosum) er større med en tydeligere stokdel og skællene er mere uregelmæssige. Sporerne er under 11 µm i diameter.",
    "oekologi": "Plettet bruskbold danner mykorrhiza med løvtræer, navnlig eg (Quercus) i skove og parker på relativt næringsrig bund - ofte på leret og forstyrret bund. Den er ret almindelig og fundet spredt over hele landet, dog mest i de østlige dele.",
    "bemaerkning": "",
    "foersteFundIDK": 0,
    "foersteReferenceForDK": 0,
    "PresentInDK": true,
    "DK_reference": "M. Jeppson  i L. Hansen & H. Knudsen, Nordic Macromycetes 3: 296, 1997.",
    "MycoKeyIDDKWebLink": "http://www.mycokey.org/speciesindex/2048/language=dk/LocalLanguage=dk",
    "internalNote": "",
    "spiselighedsrapport": "giftig",
    "BeskrivelseUK": "",
    "bogtekst_faenologi_udbredelse": "Almindelig, især mod øst; juli-oktober (-december).",
    "bogtekst_gyldendal": "Plettet bruskbold (Scleroderma areolatum) er en lille bruskbold med ret tydelig, men ret kort, rodagtig stokdel, et tyndt peridium og meget tydelige, små, regelmæssige, mørke, tiltrykte peridieskæl på en lyst gulbrun baggrund. Uden øskner i peridiet. De ret kortpiggede sporer måler 10-13 µm uden ornament.\n    Stilket bruskbold (S. verrucosum) er større,  tydeligere rodagtigt forlænget, og skællene er mere uregelmæssige. Sporerne er under 11 µm i diam.\n    Almindelig, især mod øst; juli-oktober (-december).",
    "bogtekst_gyldendal_en": "Scleroderma areolatum is a small earthball with a distinct, but rather short, root-like base, a thin, reddening peridium and very obvious, small, regular, dark, adpressed scales on a pale yellow-brown background. The hyphae lack clamps. The spherical spores have rather short spines and measure 10–13 µm (without the ornament). Ectomycorrhizal with Quercus, rarely other deciduous trees, mainly on clay-rich soils.\nScleroderma verrucosum is bigger with a larger root-like base and less regular peridial scales. The spores are less than 11 µm in diameter. See also S. cepa.\nCommon and widespread in the nemoral–hemiboreal zones; July–December.",
    "bog_Gyldendal_art_medtages": true,
    "Bogtekst_stor_art": false,
    "bog_gyldendal_korrekturlaest": true,
    "DKnavn": "plettet bruskbold",
