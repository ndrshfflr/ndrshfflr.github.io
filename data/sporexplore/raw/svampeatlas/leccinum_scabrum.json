     "vernacular_name_Fi": "",
     "vernacular_name_FR": "Bolet rude",
     "vernacular_name_GB": "Brown Birch Bolete",
     "vernacular_name_NL": "Gewone berkeboleet",
     "vernacular_name_NO": "brunskrubb",
     "vernacular_name_SE": "björksopp",
     "vernacular_name_CZ": "kozák březový",
     "valideringskrav": 0,
     "valideringsrapport": "Fund bør nøgles efter atlasnøglen. Arten kendes i felten på at hatten er brun til mørkt brun og stokken har grove sorte skæl i den nederste halvdel. Den har aldrig blågrønne pletter.",
     "basionym_described": 0,
