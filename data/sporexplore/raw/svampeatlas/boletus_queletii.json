     "vernacular_name_GB": "Deceiving Bolete",
     "vernacular_name_NL": "Gladstelige heksenboleet",
     "vernacular_name_NO": "oransje blodrørsopp",
     "vernacular_name_SE": "flamsopp",
     "vernacular_name_CZ": "hřib Quéletův",
