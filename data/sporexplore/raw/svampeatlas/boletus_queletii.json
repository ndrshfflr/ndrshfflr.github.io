    "attributes": {
     "taxon_id": 11090,
     "createdAt": "2015-09-17T10:10:03.000Z",
     "updatedAt": "2017-08-19T09:53:05.000Z",
     "diagnose": "En mellemstor, stærkt blånende rørhat med kanelbrun, rødbrun til brunorange hat, abrikosorange til brunorange rørmundinger og glat eller finprikket, tilspidsende stok  Kødet i stokbasis er oftest vinrødt. Vokser med løvtræer på god bund.",
     "beskrivelse": "",
     "forvekslingsmuligheder": "Punktstokket indigo-rørhat (Neoboletus luridiformis) har ligeledes glat-punkteret stok, men har i reglen ± cinnoberrøde rørmundinger og har ikke en afvigende farve i stokbasis. Andre, lignende indigo-rørhatte (Suillellus) har stoknet.\u000b    Sortblånende rørhat (Cyanoboletus pulverulentus) er også kraftigt blånende og glatstokket, men har gule rørmundinger.",
     "oekologi": "Glatstokket indigo-rørhat vokser under bøg (Fagus sylvatica) og eg (Quercus spp.) på leret eller kalkholdig bund. Den er kendt fra 33 lokaliteter, heraf 22 med fund efter 1990.",
     "bemaerkning": "",
     "foersteFundIDK": 0,
     "foersteReferenceForDK": 0,
     "PresentInDK": true,
     "DK_reference": "J. Vesterholt & M. Holm, Svampe 45: 4, 2002.",
     "MycoKeyIDDKWebLink": "http://www.mycokey.org/speciesindex/218/language=dk/LocalLanguage=dk",
     "internalNote": "i.f. Rald (in lit.) er B. erytropus ss orig. = queletii",
     "spiselighedsrapport": "spiselig og god",
     "BeskrivelseUK": "",
     "bogtekst_faenologi_udbredelse": "Glatstokket indigo-rørhat vokser helt overvejende med bøg på leret eller kalkrig bund. Den foretrækker varme voksesteder som den jyske østkyst nord til Aarhus og kystnære steder på Sydsjælland, Fyn og Lolland-Falster. Den findes mest i august og september, men er meget sjælden. Spiselig efter tilberedning.",
     "bogtekst_gyldendal": "",
     "bogtekst_gyldendal_en": null,
     "bog_Gyldendal_art_medtages": true,
     "Bogtekst_stor_art": true,
     "bog_gyldendal_korrekturlaest": false,
     "DKnavn": "glatstokket indigo-rørhat",
     "vernacular_name_DE": "Glattstieliger Hexenröhrling",
