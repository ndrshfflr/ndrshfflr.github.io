    "attributes": {
     "taxon_id": 11064,
     "createdAt": "2015-09-17T10:10:03.000Z",
     "updatedAt": "2017-12-19T16:11:51.000Z",
     "diagnose": "en middelstor rørhat med først fint filtet, siden fedtet-slimet, hjortebrun til orangebrun hat. Stokken er fibret-marmoreret og lyst orangebrun. De fine, bleggule rørmundinger blåner ved berøring. De ± tenformede sporer måler 12-15 x 4-5 μm. Vokser overvejende med nåletræer på mager bund, men forekommer også med bøg på morbund.",
     "beskrivelse": "",
     "forvekslingsmuligheder": "Er generelt mere tykstokket end filtrørhattene og dværgrørhattene (Xerocomus og Xerocomellus/Hortiboletus), og ingen af disse får klæbrig hat med alderen og i fugtigt vejr. Slimrørhattene (Suillus) er derimod oftest klæbrigt-slimede, men hos dem går slimlaget også ned ad stokken (det danner et slimet fællessvøb), og mange arter har en slimet ring. Brunstokket rørhat kan på grund af fraværet af røde farver minde om Karl Johan-gruppens arter (Boletus spp.), men de har net på stokken, og deres rørmundinger blåner aldrig.",
     "oekologi": "Brunstokket rørhat vokser i løv- og nåleskove, især på mager bund, og er almindelig i Danmark.",
     "bemaerkning": "",
     "foersteFundIDK": 0,
     "foersteReferenceForDK": 0,
     "PresentInDK": true,
     "DK_reference": "H. Knudsen i L. Hansen & H. Knudsen, Nordic Macromycetes 2: 61, 1992.",
     "MycoKeyIDDKWebLink": "http://www.mycokey.org/speciesindex/205/language=dk/LocalLanguage=dk",
     "internalNote": "",
     "spiselighedsrapport": "spiselig",
     "BeskrivelseUK": "",
     "bogtekst_faenologi_udbredelse": "Vidt udbredt og almindelig; (juni-) juli-november (-december).",
     "bogtekst_gyldendal": "Brunstokket rørhat (Imleria badia) er en middelstor rørhat med først fint filtet, siden fedtet-slimet, hjortebrun til orangebrun hat. Stokken er fibret-marmoreret og lyst orangebrun. De fine, bleggule rørmundinger blåner ved berøring. De ± tenformede sporer måler 12-15 x 4-5 μm. Vokser overvejende med nåletræer på mager bund, men forekommer også med bøg på morbund.\n    Er generelt mere tykstokket end filtrørhattene og dværgrørhattene (Xerocomus og Xerocomellus/Hortiboletus), og ingen af disse får klæbrig hat med alderen og i fugtigt vejr. Slimrørhattene (Suillus) er derimod oftest klæbrigt-slimede, men hos dem går slimlaget også ned ad stokken (det danner et slimet fællessvøb), og mange arter har en slimet ring. Brunstokket rørhat kan på grund af fraværet af røde farver minde om Karl Johan-gruppens arter (Boletus spp.), men de har net på stokken, og deres rørmundinger blåner aldrig.\n    Vidt udbredt og almindelig; (juni-) juli-november (-december).",
     "bogtekst_gyldendal_en": null,
