   "attributes": {
    "taxon_id": 11061,
    "createdAt": "2015-09-17T10:10:03.000Z",
    "updatedAt": "2017-12-19T10:12:01.000Z",
    "diagnose": "en stor rørhat med tør, mørkt gråbrun, meget fint filtet hat, først hvidlige, siden gullige, små rørmundinger og et hvidligt net ned ad stokken. Sporerne måler 14-17 x 4,5-6 μm. Vokser med bøg og eg på varme lokaliteter med leret eller kalkholdig bund.",
    "beskrivelse": "",
    "forvekslingsmuligheder": "Den påfaldende mørkebrune, tørre, fint filtede hat adskiller den fra Karl Johan (B. edulis). Sommer-rørhat (B. reticulatus) kendes på sine lysere farver. Rødbrun rørhat (B. pinophilus) forkommer kun i nåleskove.",
    "oekologi": "Bronze-rørhat vokser under bøg (Fagus sylvatica) og eg (Quercus spp.) på leret eller kalkholdig bund. Den er kendt fra 41 lokaliteter, heraf 12 med fund efter 1990. Mange af de tidligere kendte steder er i Storstrøms Amt.",
    "bemaerkning": "",
    "foersteFundIDK": 0,
    "foersteReferenceForDK": 0,
    "PresentInDK": true,
    "DK_reference": "J. Vesterholt & P.B. Hansen, Svampe 42: 14, 2000.",
    "MycoKeyIDDKWebLink": "http://www.mycokey.org/speciesindex/202/language=dk/LocalLanguage=dk",
    "internalNote": "",
    "spiselighedsrapport": "spiselig og god",
    "BeskrivelseUK": "",
    "bogtekst_faenologi_udbredelse": "Forekommer især i Østjylland, på Sydfyn og på Lolland-Falster, men er overalt sjælden; juli-oktober.",
    "bogtekst_gyldendal": "Bronze-rørhat (Boletus aereus) er en stor rørhat med tør, mørkt gråbrun, meget fint filtet hat, først hvidlige, siden gullige, små rørmundinger og et hvidligt net ned ad stokken. Sporerne måler 14-17 x 4,5-6 μm. Vokser med bøg og eg på varme lokaliteter med leret eller kalkholdig bund.\n    Den påfaldende mørkebrune, tørre, fint filtede hat adskiller den fra Karl Johan (B. edulis). Sommer-rørhat (B. reticulatus) kendes på sine lysere farver. Rødbrun rørhat (B. pinophilus) forkommer kun i nåleskove.\n    Forekommer især i Østjylland, på Sydfyn og på Lolland-Falster, men er overalt sjælden; juli-oktober.",
    "bogtekst_gyldendal_en": "Boletus aereus is a large bolete with a dry, dark grey-brown, very finely felty cap that usually has small, whitish crystalline granules (inset picture). The stem is ± yellowish-brown and has a whitish reticulum. The spores measure 14–17 × 4.5–6 µm. Occurs with Fagus and Quercus in thermophilous habitats on clay-rich soils.\nBoletus edulis is paler and has a greasy, elastic cap cuticle. Boletus reticulatus has paler, less contrasting colours. Boletus pinophilus only occurs with conifers.\nMainly a southern species, locally common, absent from the boreal zone; July–October.",
    "bog_Gyldendal_art_medtages": true,
    "Bogtekst_stor_art": false,
    "bog_gyldendal_korrekturlaest": true,
