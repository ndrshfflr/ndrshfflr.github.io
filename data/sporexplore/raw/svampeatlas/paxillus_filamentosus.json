    "attributes": {
     "taxon_id": 70686,
     "createdAt": "2021-06-22T10:57:06.000Z",
     "updatedAt": "2021-06-22T11:13:30.000Z",
     "diagnose": "Elle-netbladhat i bred forstand består af tre arter, hvoraf de to, P. olivellus og P. adelpha, er kendt fra jord-DNA i Danmark. Paxillus rubicundulus er beskrevet fra Skotland og burde også forekomme i Danmark. Navnet P. filamentosus er nu helt opgivet som navn for en elle-tilknyttet netbladhat. De tre arter kan med besvær adskilles på en kombination af sporefaconer og farven på sporefældningen. Hatten er ± skællet og overfladerne rødmer; kødet er ± gult. Alle har små sporer (under 8 µm lange) i forhold til de andre danske netbladhatte. På tør til våd bund med el.",
     "beskrivelse": null,
     "forvekslingsmuligheder": "Almindelig netbladhat (P. involutus) står ikke så fugtigt med el, har noget større sporer og ikke tydeligt gult kød.",
     "oekologi": "Elle-netbladhat vokser under el (Alnus spp.) og findes hist og her i Danmark.",
     "bemaerkning": null,
     "foersteFundIDK": null,
     "foersteReferenceForDK": null,
     "PresentInDK": true,
     "DK_reference": "H. Knudsen i L. Hansen & H. Knudsen, Nordic Macromycetes 2: 54, 1992.",
     "MycoKeyIDDKWebLink": null,
     "internalNote": "Hahn, C. 2012. Bestimmungsschlüssel der kremplingsartigen Boletales Europas. Mycologia Bavarica 13: 59-68. Bruger stadig navnet rubicundulus for dette taxon.",
     "spiselighedsrapport": null,
     "BeskrivelseUK": null,
     "bogtekst_faenologi_udbredelse": "Ret almindelig, men næsten udelukkende øst for israndslinien; (maj-) juli-oktober.",
     "bogtekst_gyldendal": "Elle-netbladhat (Paxillus filamentosus) er en relativt spinkel, meget randribbet netbladhat med et tydeligt gultonet kød. Sporerne måler 5,5-8,5 x 4-5 μm. På fugtig jord med el og muligvis også med hassel.\n    Almindelig netbladhat (P. involutus) står ikke så fugtigt med el, har noget større sporer og ikke tydeligt gult kød.\n    Ret almindelig, men næsten udelukkende øst for israndslinien; (maj-) juli-oktober.",
     "bogtekst_gyldendal_en": "Paxillus filamentosus is a relatively slender, very strongly ribbed Paxillus with a distinct yellow tinge to the flesh. The cap surface often cracks into a net-like pattern. The spores measure 5.5–8.5 × 4–5 µm. Occurs on damp soils, mycorrhizal with Alnus.\nPaxillus involutus occurs in drier habitats and not with Alnus. It has somewhat larger spores and less yellow tinges in the flesh. Alnus-associated Paxillus species are sometimes treated as more than one species, and the name P. rubicundulus is often used instead of P. filamentosus.\nWidespread and rather common; May–October.",
     "bog_Gyldendal_art_medtages": true,
     "Bogtekst_stor_art": false,
     "bog_gyldendal_korrekturlaest": true,
     "DKnavn": "elle-netbladhat",
     "vernacular_name_DE": null,
     "vernacular_name_Fi": null,
     "vernacular_name_FR": null,
     "vernacular_name_GB": null,
     "vernacular_name_NL": "Elzekrulzoom",
     "vernacular_name_NO": "orepluggsopp",
     "vernacular_name_SE": "al-pluggskivling",
     "vernacular_name_CZ": "čechratka olšová",
     "valideringskrav": 2,
     "valideringsrapport": "Der ønskes beskivelse af voksestedet og om hatoverfladen er ribbet eller ikke. Brug gerne atlasprojektets nøgle, og i tvivlstilfælde oploades billede og/eller sporemål oplyses eller materiale sendes til Thomas Læssøe.",
